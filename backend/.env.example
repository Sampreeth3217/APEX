# Copy to backend/.env and fill in. Nothing here points at Emergent.
PORT=8002

# Your Supabase project (Settings -> API / Database)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Session pooler connection string, only used by `npm run migrate`
SUPABASE_DB_URL=

# OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=
LLM_MODEL_CHEAP=anthropic/claude-haiku-5.5
LLM_MODEL_MID=anthropic/claude-sonnet-5.5
EMBED_MODEL=none
LLM_DAILY_BUDGET_USD=3
LLM_TOTAL_BUDGET_USD=20
# LLM_DISABLED=true   # uncomment to run without any AI calls

CRON_SECRET=change-me
ADMIN_EMAILS=bsrinand@gmail.com
DEMO_MODE=true
APP_URL=http://localhost:3000
